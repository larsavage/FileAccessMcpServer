# =============================================================================
# .gitignore для FileAccessMcpServer - C# ASP.NET Core MCP Server
# =============================================================================

# ---- .NET build output -----------------------------------------------------
bin/
obj/
artifacts/

# ---- Скомпилированные артефакты (остальное покрыто bin/obj/) ---------------
*.nupkg
*.snupkg
*.cache

# ---- Пользовательские настройки Visual Studio --------------------------------
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates
*.*.user
*.csproj.user

# ---- JetBrains Rider / ReSharper -------------------------------------------
.idea/
_ReSharper.Caches/
*.DotSettings.user

# ---- VS Code ----------------------------------------------------------------
.vscode/
*.code-workspace

# ---- Секреты и сертификаты ---------------------------------------------------
*.pfx
*.snk
UserSecrets.json
appsettings.*.local.json
config.json
config.*.local.json
*.env
.env.local
.env.*.local

# ---- Логи --------------------------------------------------------------------
Logs/
logs/
*.log

# ---- Временные и резервные файлы -----------------------------------------------
*~
*.tmp
*.bak
*.swp
*.swn

# ---- Результаты тестов и покрытие ---------------------------------------------
test-results/
TestResults/
coverage/
*.trx
*.coverage
*.coveragexml

# ---- Публикация и релиз --------------------------------------------------------
Publish/
publish/
ReleaseFiles/
dist/

# ---- Платформенно-специфичные ---------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- MCP конфигурация внешних инструментов --------------------------------------
*.mcp.json
